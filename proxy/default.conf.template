server {
    listen       80;
    listen       443 ssl;

    ssl_certificate /etc/rpcssl/rpc.pem;
    ssl_certificate_key /etc/rpcssl/rpc.key;
    server_name  devnet-rpc.secexplorer.io;
    proxy_http_version 1.1;

    # JSON-RPC HTTP
    location / {
        proxy_pass            http://eth:8545;
        proxy_http_version    1.1;
        proxy_buffering       off;
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_cache_bypass    $http_upgrade;
    }

    # JSON-RPC WebSocket (optional): wss://devnet-rpc.../ws
    location /ws {
        proxy_pass            http://eth:8546;
        proxy_http_version    1.1;
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_read_timeout    300s;
    }
}